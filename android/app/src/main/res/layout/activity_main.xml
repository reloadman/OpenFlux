<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="URL документа"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://docs.yandex.ru/docs/view/..."
        android:inputType="textUri"
        android:maxLines="3"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Остановлен"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/detailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp" />


    <TextView
        android:id="@+id/dnsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DNS идёт через туннель по TCP — отдельных настроек не требуется"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/toggleButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="ВКЛЮЧИТЬ"
        android:textSize="16sp"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/logText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical" />
</LinearLayout>
